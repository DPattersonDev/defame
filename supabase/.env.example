# Supabase supplies its URL and service role key to deployed functions.
# Keep secrets on the server. Never put these in Dart or commit actual values.
# Keep paid AI off until explicitly ready to activate it.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ALLOW_PAID=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Independent verification provider adapter, not a client success redirect.
VERIFICATION_PROVIDER_NAME=
VERIFICATION_PRIVACY_URL=
VERIFICATION_START_URL=
VERIFICATION_API_KEY=
VERIFICATION_WEBHOOK_SECRET=
